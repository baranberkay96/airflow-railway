{
  "name": "Apache Airflow 3 Data Pipelines",
  "description": "Schedule and monitor DAGs with Celery workers, Redis and Postgres.",
  "category": "Automation",
  "tags": [
    "airflow",
    "data-pipelines",
    "etl",
    "orchestration",
    "celery",
    "python"
  ],
  "services": {
    "airflow-apiserver": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/apache-airflow.svg",
      "source": {
        "repo": "baranberkay96/airflow-railway",
        "rootDirectory": "/services/airflow"
      },
      "startCommand": "/opt/railway/bin/railway-airflow api-server",
      "healthcheckPath": "/api/v2/monitor/health",
      "healthcheckTimeout": 900,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN": {
          "defaultValue": "${{Postgres.DATABASE_URL}}",
          "description": "Metadata database (Railway Postgres, private network).",
          "required": true
        },
        "AIRFLOW__CELERY__BROKER_URL": {
          "defaultValue": "${{Redis.REDIS_URL}}/0",
          "description": "Celery broker (Railway Redis, DB 0).",
          "required": true
        },
        "AIRFLOW__CORE__EXECUTION_API_SERVER_URL": {
          "defaultValue": "http://${{airflow-apiserver.RAILWAY_PRIVATE_DOMAIN}}:8080/execution/",
          "description": "Task Execution API that workers/triggerer call (private network).",
          "required": true
        },
        "AIRFLOW__LOGGING__REMOTE_LOGGING": {
          "defaultValue": "True",
          "description": "Ship task logs to the Railway Bucket.",
          "required": false
        },
        "AIRFLOW__LOGGING__REMOTE_BASE_LOG_FOLDER": {
          "defaultValue": "s3://${{Bucket.BUCKET}}/task-logs",
          "description": "Bucket path for task logs.",
          "required": false
        },
        "AIRFLOW__LOGGING__REMOTE_LOG_CONN_ID": {
          "defaultValue": "railway_bucket",
          "description": "Airflow connection used for remote logs.",
          "required": false
        },
        "AIRFLOW__CORE__FERNET_KEY": {
          "defaultValue": "${{secret(43, \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\")}}=",
          "description": "Fernet key that encrypts connections/variables. Shared by all Airflow services; never change after first boot.",
          "required": true
        },
        "AIRFLOW__API_AUTH__JWT_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs task-execution JWTs. Shared by all Airflow services.",
          "required": true
        },
        "AIRFLOW__API__SECRET_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "API/log-server secret. Shared by all Airflow services.",
          "required": true
        },
        "AIRFLOW_CONN_RAILWAY_BUCKET": {
          "defaultValue": "{\"conn_type\": \"aws\", \"login\": \"${{Bucket.ACCESS_KEY_ID}}\", \"password\": \"${{Bucket.SECRET_ACCESS_KEY}}\", \"extra\": {\"endpoint_url\": \"${{Bucket.ENDPOINT}}\", \"region_name\": \"${{Bucket.REGION}}\", \"config_kwargs\": {\"s3\": {\"addressing_style\": \"virtual\"}}}}",
          "description": "Airflow connection (JSON) for the Railway Bucket; used for remote task logs.",
          "required": true
        },
        "AIRFLOW_DAGS_GIT_URL": {
          "defaultValue": "https://github.com/baranberkay96/airflow-railway.git",
          "description": "Git repo holding your DAGs (GitDagBundle). Empty = example DAGs baked into the image.",
          "required": false
        },
        "AIRFLOW_DAGS_GIT_REF": {
          "defaultValue": "main",
          "description": "Branch, tag or commit to track.",
          "required": false
        },
        "AIRFLOW_DAGS_GIT_SUBDIR": {
          "defaultValue": "services/airflow/dags",
          "description": "Folder inside the repo that contains the DAG files (empty = repo root).",
          "required": false
        },
        "AIRFLOW_DAGS_REFRESH_SECS": {
          "defaultValue": "120",
          "description": "How often Airflow fetches new commits.",
          "required": false
        },
        "PORT": {
          "defaultValue": "8080",
          "description": "API server port (Railway healthcheck + domain).",
          "required": false
        },
        "AIRFLOW__API__PORT": {
          "defaultValue": "8080",
          "description": "Port uvicorn listens on.",
          "required": false
        },
        "AIRFLOW__API__HOST": {
          "defaultValue": "::",
          "description": "Dual-stack bind so IPv4 and IPv6 private-network clients both reach the API.",
          "required": false
        },
        "AIRFLOW__API__WORKERS": {
          "defaultValue": "2",
          "description": "Uvicorn worker processes (>1 also enables the dual-stack socket).",
          "required": false
        },
        "AIRFLOW__API__BASE_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of the UI.",
          "required": false
        },
        "FORWARDED_ALLOW_IPS": {
          "defaultValue": "*",
          "description": "Trust X-Forwarded-* from Railway's proxy (HTTPS links).",
          "required": false
        },
        "AIRFLOW_ADMIN_USERNAME": {
          "defaultValue": "admin",
          "description": "Admin login created by airflow-init.",
          "required": true
        },
        "AIRFLOW_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Admin password (generated). Only used on first creation.",
          "required": true
        },
        "AIRFLOW_ADMIN_EMAIL": {
          "defaultValue": "admin@example.com",
          "description": "Admin email.",
          "required": false
        }
      },
      "preDeployCommand": [
        "/opt/railway/bin/railway-airflow migrate"
      ],
      "preDeployTimeoutSeconds": 900
    },
    "airflow-init": {
