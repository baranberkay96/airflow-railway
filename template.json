          "description": "Bucket path for task logs.",
          "required": false
        },
        "AIRFLOW__LOGGING__REMOTE_LOG_CONN_ID": {
          "defaultValue": "railway_bucket",
          "description": "Airflow connection used for remote logs.",
          "required": false
        },
        "AIRFLOW__CORE__FERNET_KEY": {
          "defaultValue": "${{airflow-apiserver.AIRFLOW__CORE__FERNET_KEY}}",
          "description": "Same value as on airflow-apiserver.",
          "required": true
        },
        "AIRFLOW__API_AUTH__JWT_SECRET": {
          "defaultValue": "${{airflow-apiserver.AIRFLOW__API_AUTH__JWT_SECRET}}",
          "description": "Same value as on airflow-apiserver.",
          "required": true
        },
        "AIRFLOW__API__SECRET_KEY": {
          "defaultValue": "${{airflow-apiserver.AIRFLOW__API__SECRET_KEY}}",
          "description": "Same value as on airflow-apiserver.",
          "required": true
        },
        "AIRFLOW_CONN_RAILWAY_BUCKET": {
          "defaultValue": "${{airflow-apiserver.AIRFLOW_CONN_RAILWAY_BUCKET}}",
          "description": "Same value as on airflow-apiserver.",
          "required": false
        },
        "AIRFLOW_DAGS_GIT_URL": {
          "defaultValue": "${{airflow-apiserver.AIRFLOW_DAGS_GIT_URL}}",
          "description": "Same value as on airflow-apiserver.",
          "required": false
        },
        "AIRFLOW_DAGS_GIT_REF": {
          "defaultValue": "${{airflow-apiserver.AIRFLOW_DAGS_GIT_REF}}",
          "description": "Same value as on airflow-apiserver.",
          "required": false
        },
        "AIRFLOW_DAGS_GIT_SUBDIR": {
          "defaultValue": "${{airflow-apiserver.AIRFLOW_DAGS_GIT_SUBDIR}}",
          "description": "Same value as on airflow-apiserver.",
          "required": false
        },
        "AIRFLOW_DAGS_REFRESH_SECS": {
          "defaultValue": "${{airflow-apiserver.AIRFLOW_DAGS_REFRESH_SECS}}",
          "description": "Same value as on airflow-apiserver.",
          "required": false
        },
        "AIRFLOW__CELERY__WORKER_CONCURRENCY": {
          "defaultValue": "8",
          "description": "Task slots per worker replica.",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "300",
          "description": "Time running tasks get to finish on redeploy (Celery warm shutdown).",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18"
      },
      "startCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": true
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": true
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": true
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": true
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": true
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": true
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": true
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "URL to connect to Postgres database.",
          "required": true
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": true
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": true
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": true
        }
      }
    },
    "Redis": {
      "icon": "https://cdn.sanity.io/images/sy1jschh/production/0ce0bfdcfbdbf69662b1116671f97c2dd788b655-157x157.svg",
      "source": {
        "image": "redis:8.2"
      },
      "startCommand": "/bin/sh -c \"rm -rf $RAILWAY_VOLUME_MOUNT_PATH/lost+found/ && exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --save 60 1 --dir $RAILWAY_VOLUME_MOUNT_PATH\"",
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/data"
      },
      "variables": {
        "REDISHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private network hostname of the Redis service, only resolvable from services in the same environment",
          "required": true
        },
        "REDISPORT": {
          "defaultValue": "6379",
          "description": "Port that Redis listens on",
          "required": true
        },
        "REDISUSER": {
          "defaultValue": "default",
          "description": "Username for authenticating with Redis",
          "required": true
        },
        "REDIS_URL": {
          "defaultValue": "redis://${{ REDISUSER }}:${{ REDIS_PASSWORD }}@${{ REDISHOST }}:${{ REDISPORT }}",
          "description": "Connection string for connecting to Redis using the private network",
          "required": true
        },
        "REDISPASSWORD": {
          "defaultValue": "${{REDIS_PASSWORD}}",
          "description": "Alias of REDIS_PASSWORD for clients that expect the unseparated name",
          "required": true
        },
        "REDIS_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Randomly generated password for authenticating with Redis",
          "required": true
        }
      }
    }
  },
  "buckets": [
    "Bucket"
  ]
}
